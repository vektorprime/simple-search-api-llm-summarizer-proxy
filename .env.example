# --- Required ---
EXA_API_KEY=your-exa-api-key-here
# Optional display-only value (proxy accepts any key on /search)
PROXY_API_KEY=

# --- LLM: OpenAI-compatible backend (e.g. llama.cpp) ---
# Provider gates backend-specific options (currently only llama.cpp slot pinning).
LLM_PROVIDER=llamacpp
LLM_BASE_URL=http://10.0.0.187:8005/v1
LLM_MODEL=Muse-Glimmer-30B
LLM_API_KEY=sk-no-key-required
# Manage llama.cpp slot assignment: rotate each job across the first N
# 0-based slot ids (0..N-1). A job landing on a busy slot waits its turn.
LLAMACPP_USE_SLOTS=false
LLAMACPP_SLOT_COUNT=1
# Operation mode: summary | summary-caveman | original | original-caveman.
# original = raw text, no LLM call. *-caveman = telegraphic style.
MODE=summary
# Break long pages into <=CHUNK_TARGET_CHARS parts, summarize each part with
# the Mode rules, and join the outputs deterministically (no final LLM call).
# For small-context models and very large pages. Pages under the target are
# summarized whole regardless.
CHUNKED_SUMMARY=false
CHUNK_TARGET_CHARS=2600
# Chunking only kicks in above this many chars (and only when enabled).
CHUNK_MIN_CHARS=5000
# Append page image URLs to the snippet body as text for the downstream LLM.
RETURN_IMAGE_URLS=false
# Legacy alias: CAVEMAN_STYLE=true behaves like MODE=original-caveman
# when MODE is unset. Prefer MODE for new installs.
# CAVEMAN_STYLE=false
LLM_TIMEOUT_SEC=300
# Max tokens per summary. 0 (default) or negative omits the limit (server
# default: unlimited). If set, keep >=1500: reasoning tokens come out of this budget.
LLM_MAX_TOKENS=0

# --- Exa ---
EXA_BASE_URL=https://api.exa.ai
EXA_TIMEOUT_SEC=20
# 0 = unlimited: fetch all the API returns per result.
EXA_TEXT_MAX_CHARS=0

# --- Admin UI login (HTTP Basic for /admin and /config) ---
ADMIN_USER=admin
ADMIN_PASS=admin

# --- Proxy (summaries run 1-at-a-time against the LLM backend; rest queue) ---
PORT=8555
MAX_CONCURRENT_SUMMARIES=1
# 0 = unlimited: forward everything fetched to the LLM.
SUMMARY_INPUT_MAX_CHARS=0
# Pages shorter than this skip the local LLM entirely (returned verbatim).
# 0 = summarize everything.
SUMMARY_MIN_CHARS=10000
REQUEST_TIMEOUT_SEC=1200

# --- Optional exact-match result cache (off by default) ---
# Key = lowercased query + count + fingerprint(MODE, RETURN_IMAGE_URLS).
# Fresh window: serve directly, zero Exa/LLM calls. Stale window up to TTL:
# re-run Exa and reuse cache only if fresh results match stored text.
CACHE_ENABLED=false
CACHE_LINK_ENABLED=true
CACHE_TTL_SEC=172800
CACHE_FRESH_SEC=86400
CACHE_MAX_ENTRIES=200
CACHE_DB_FILE=./cache.db
# Legacy JSON store: imported once into CACHE_DB_FILE on first start if the
# database is empty, then ignored. Safe to delete afterwards.
CACHE_FILE=./cache.json
