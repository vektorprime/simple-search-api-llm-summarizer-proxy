# --- Required ---
EXA_API_KEY=your-exa-api-key-here
# Optional display-only value (proxy accepts any key on /search)
PROXY_API_KEY=

# --- LLM: OpenAI-compatible backend (e.g. llama.cpp) ---
# Provider gates backend-specific options (currently only llama.cpp slot pinning).
LLM_PROVIDER=llamacpp
LLM_BASE_URL=http://10.0.0.187:8005/v1
LLM_MODEL=Muse-Glimmer-30B
LLM_API_KEY=sk-no-key-required
# Pin jobs to one llama.cpp slot via id_slot (used only when
# LLM_PROVIDER=llamacpp and LLAMACPP_USE_SLOTS=true).
LLAMACPP_USE_SLOTS=false
LLAMACPP_SLOT_ID=1
# Operation mode: summary | summary-caveman | original | original-caveman.
# original = raw text, no LLM call. *-caveman = telegraphic style.
MODE=summary
# Append page image URLs to the snippet body as text for the downstream LLM.
RETURN_IMAGE_URLS=false
# Legacy alias: CAVEMAN_STYLE=true behaves like MODE=original-caveman
# when MODE is unset. Prefer MODE for new installs.
# CAVEMAN_STYLE=false
LLM_TIMEOUT_SEC=300
# Max tokens per summary. 0 (default) or negative omits the limit (server
# default: unlimited). If set, keep >=1500: reasoning tokens come out of this budget.
LLM_MAX_TOKENS=0

# --- Exa ---
EXA_BASE_URL=https://api.exa.ai
EXA_TIMEOUT_SEC=20
EXA_TEXT_MAX_CHARS=8000

# --- Admin UI login (HTTP Basic for /admin and /config) ---
ADMIN_USER=admin
ADMIN_PASS=admin

# --- Proxy (summaries run 1-at-a-time against the LLM backend; rest queue) ---
PORT=8555
MAX_CONCURRENT_SUMMARIES=1
SUMMARY_INPUT_MAX_CHARS=12000
REQUEST_TIMEOUT_SEC=1200
